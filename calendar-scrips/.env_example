# Configuration for the Weekly Calendar Report (SPEC §4).
#
# Copy this file to `.env` (same directory as the scripts) and fill in the real
# values. `.env` is gitignored and must NEVER be committed.
#
#     cp .env.example .env
#     chmod 600 .env
#
# Real exported environment variables take precedence over this file, so the
# same code works on a dev machine, on the Pi, and in a CI runner.

# === Google Calendar (REQUIRED) =============================================
# Service-account credential with read-only Calendar access. Either:
#   (a) an absolute path to the downloaded JSON key file, e.g.
#       CALENDAR_CREDENTIALS=/home/pi/raspberry-scripts/calendar-scrips/service-account.json
#   (b) OR the JSON content itself on a single line (handy for CI secrets).
# Share your calendar with the service account's email ("See all event
# details") — see the README for the full walk-through.
CALENDAR_CREDENTIALS=/home/pi/raspberry-scripts/calendar-scrips/service-account.json

# Target calendar id. For your personal calendar this is usually your Google
# account email address (the calendar you shared with the service account).
CALENDAR_ID=you@gmail.com

# === Optional behaviour =====================================================
# IANA timezone used for the week window and display (default America/Santiago).
CALENDAR_TZ=America/Santiago

# Which week to report: "upcoming" (default) or "past".
REPORT_SCOPE=upcoming

# Output language for the summary (default Spanish). "English" is also supported
# for the factual text; the AI rewrite honours any language you name.
REPORT_LANGUAGE=Spanish

# === Telegram delivery (enable by setting BOTH) =============================
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321

# === Email delivery (enable by setting ALL of HOST/USER/PASS/MAIL_TO) =======
# For Gmail, SMTP_PASS is an app-specific password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
MAIL_TO=you@gmail.com

# === Optional AI rewrite ====================================================
# If set, the factual summary is rewritten into a short friendly briefing via
# the Anthropic API. If unset, the factual list is delivered as-is.
# NOTE: enabling this sends your calendar summary to the LLM provider.
LLM_API_KEY=sk-ant-...
# Optional model override (default: a small/cheap tier).
LLM_MODEL=claude-haiku-4-5
