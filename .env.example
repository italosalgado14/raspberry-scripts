# Telegram credentials for the Weather Notifier.
#
# Copy this file to `.env` (same directory as the scripts) and fill in the
# real values. `.env` is gitignored and must never be committed.
#
#     cp .env.example .env
#     chmod 600 .env
#
# How to obtain the values (see Instructions.md §7):
#   1. In Telegram, open @BotFather -> /newbot -> follow the prompts ->
#      copy the HTTP API token it gives you into TELEGRAM_TOKEN below.
#   2. Send your new bot any message, then open
#      https://api.telegram.org/bot<TELEGRAM_TOKEN>/getUpdates
#      and copy the "chat":{"id": ...} value into TELEGRAM_CHAT_ID.

TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321
